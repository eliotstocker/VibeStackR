[0.021, "o", "\u001b[3D\u001b[3B\r\u001b[1A\u001b[38;2;177;185;249m/caveman-stats                                        (caveman) Show real token usage and estimated savings for the current session. Reads directly\u001b[39m\r\r\n\u001b[54C\u001b[38;2;177;185;249mfrom\u001b[1Cthe\u001b[1CClaude\u001b[1CCode\u001b[1Csession\u001b[1Clog\u001b[1C\u2014\u001b[1Cno\u001b[1CAI\u001b[1Cestimation.\u001b[1CTriggers\u001b[1Con\u001b[1C/caveman-stats.\u001b[1COutput\u001b[1Cis\u001b[1Cin\u2026\u001b[39m\r\r\n\u001b[38;2;153;153;153m/caveman\u001b[46C(caveman)\u001b[1CUltra-compressed\u001b[1Ccommunication\u001b[1Cmode.\u001b[1CCuts\u001b[1Ctoken\u001b[1Cusage\u001b[1C~75%\u001b[1Cby\u001b[1Cspeaking\u001b[1Clike\u001b[1Ccaveman\u001b[39m\r\r\n\u001b[54C\u001b[38;2;153;153;153mwhile\u001b[1Ckeeping\u001b[1Cfull\u001b[1Ctechnical\u001b[1Caccuracy.\u001b[1CSupports\u001b[1Cintensity\u001b[1Clevels:\u001b[1Clite,\u001b[1Cfull\u001b[1C(default),\u001b[1Cultra\u2026\u001b[39m\r\r\n\u001b[38;2;153;153;153m/caveman-help\u001b[41C(caveman)\u001b[1CQuick-reference\u001b[1Ccard\u001b[1Cfor\u001b[1Call\u001b[1Ccaveman\u001b[1Cmodes,\u001b[1Cskills,\u001b[1Cand\u001b[1Ccommands.\u001b[1COne-shot\u001b[1Cdisplay,\u001b[39m\r\r\n\u001b[54C\u001b[38;2;153;153;153mnot\u001b[1Ca\u001b[1Cpersistent\u001b[1Cmode.\u001b[1CTrigger:\u001b[1C/caveman-help,\u001b[1C\"caveman\u001b[1Chelp\",\u001b[1C\"what\u001b[1Ccaveman\u001b[1Ccommands\",\u001b[1C\"how\u001b[1C\u2026\u001b[39m\r\r\n"]
