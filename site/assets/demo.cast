[0.014, "o", "\u001b[6D\u001b[8B\r\u001b[1C\u001b[5A\u001b[38;2;153;153;153mclaude-api\u001b[43CBuild,\u001b[1Cdebug, and optimize Claude API / Anthrop\u001b[1Cc SDK apps. Apps built with this skill should\r\u001b[1B\u001b[39m                                                      \u001b[38;2;153;153;153minclude prompt caching. Also handles migrating \u001b[38;2;177;185;249mexi\u001b[38;2;153;153;153msting Claude API code between Claude model \u2026\r\u001b[1C\u001b[1Bpaseo-loop\u001b[43CRun \u001b[1Cn agent loop\u001b[1Cuntil an \u001b[38;2;177;185;249mexi\u001b[38;2;153;153;153mt\u001b[1Ccondition is\u001b[1Cmet. Use when the user says \"loop\", \"babysit\",\r\u001b[1B\u001b[39m                                                      \u001b[38;2;153;153;153m\"keep trying until\", \"check ev\u001b[1Cry X\", \"watch\", or wants iter\u001b[1Ctive autonomous execution. (user)\r\u001b[54C\u001b[1B\u001b[39m                                                                                              \r\r\n\u001b[6C\u001b[8A"]
