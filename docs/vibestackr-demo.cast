[0.006, "o", "\u001b[3D\u001b[3B\r\u001b[1A\u001b[38;2;177;185;249m/caveman-stats                                        (caveman) Show real token usage and estimated savings for the current session. Reads directly\u001b[39m\r\r\n\u001b[54C\u001b[38;2;177;185;249mfrom\u001b[1Cthe\u001b[1CClaude\u001b[1CCode\u001b[1Csession\u001b[1Clog\u001b[1C\u2014\u001b[1Cno\u001b[1CAI\u001b[1Cestimation.\u001b[1CTriggers\u001b[1Con\u001b[1C/caveman-stats.\u001b[1COutput\u001b[1Cis\u001b[1Cin\u2026\u001b[39m\r\r\n\u001b[38;2;153;153;153m/paseo\u001b[48CPaseo\u001b[1Creference\u001b[1Cfor\u001b[1Cmanaging\u001b[1Cworkspaces,\u001b[1Cworkspace\u001b[1Cscripts,\u001b[1Cagents,\u001b[1Cschedules,\u001b[1Cand\u001b[1Cheartbeats.\u001b[39m\r\r\n\u001b[54C\u001b[38;2;153;153;153m(user)\u001b[39m\r\r\n\u001b[38;2;153;153;153m/caveman\u001b[46C(caveman)\u001b[1CUltra-compressed\u001b[1Ccommunication\u001b[1Cmode.\u001b[1CCuts\u001b[1Ctoken\u001b[1Cusage\u001b[1C~75%\u001b[1Cby\u001b[1Cspeaking\u001b[1Clike\u001b[1Ccaveman\u001b[39m\r\r\n\u001b[54C\u001b[38;2;153;153;153mwhile\u001b[1Ckeeping\u001b[1Cfull\u001b[1Ctechnical\u001b[1Caccuracy.\u001b[1CSupports\u001b[1Cintensity\u001b[1Clevels:\u001b[1Clite,\u001b[1Cfull\u001b[1C(default),\u001b[1Cultra\u2026\u001b[39m\r\r\n\u001b[3C\u001b[8A"]
[0.438, "o", "\u001b[3D\u001b[8B\r\u001b[3C\u001b[8Ae\u001b[7m \u001b[27m\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[4C\u001b[8A"]
[0.005, "o", "\u001b[4D\u001b[8B\r\u001b[1C\u001b[6A\u001b[38;2;177;185;249mexit         \u001b[40CExit the CLI\u001b[39m                                                                                 \r\u001b[1B\u001b[38;2;153;153;153m/\u001b[38;2;177;185;249me\u001b[38;2;153;153;153mffort                                               S\u001b[38;2;177;185;249me\u001b[38;2;153;153;153mt effort level for model usage\u001b[39m                                                              \r\u001b[1C\u001b[1B\u001b[38;2;177;185;249me\u001b[38;2;153;153;153mxport\u001b[47C\u001b[38;2;177;185;249mE\u001b[38;2;153;153;153mxport th\u001b[1C current conversation to \u001b[1C file \u001b[2C clipboard\u001b[39m                                        \r\u001b[1B\u001b[38;2;153;153;153m/\u001b[38;2;177;185;249me\u001b[38;2;153;153;153mxtra-usage                                          Configur\u001b[38;2;177;185;249me\u001b[38;2;153;153;153m extra usage to keep working when limits are hit\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249me\u001b[3C\u001b[38;2;153;153;153m-stats\u001b[44C\u001b[38;2;177;185;249me\u001b[5C\u001b[38;2;153;153;153mShow real token usage and estimated savings for\u001b[1Cthe current se\u001b[1Csion. Reads directly\r\u001b[54C\u001b[1B"]
[0.0, "o", "from th\u001b[38;2;177;185;249me\u001b[38;2;153;153;153m Claude Code session\u001b[1Clog \u2014 no AI estimat\u001b[1Con. Triggers on /cav\u001b[1Cman-stats. O\u001b[1Ctput\u001b[1Cis in\u001b[39m\r\r\n\u001b[4C\u001b[8A"]
